# ==============================================
# Portfolio CMS — Environment Variables
# ==============================================
# Copy this file to server/.env and fill in real values.
# NEVER commit the actual .env file to Git.

# Server port (local dev only)
PORT=5000

# PostgreSQL connection string (use Neon, Supabase, or similar)
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# JWT secret — generate a strong random string (64+ chars)
# Run: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="change-this-to-a-strong-random-secret"

# Initial admin password — used by seed script for first-time setup
# Change this immediately after first login
ADMIN_INITIAL_PASSWORD="YourStrongPassword123!"

# Initial admin email — used by seed script
ADMIN_EMAIL="admin@portfolio.com"

# Frontend URL (local dev)
CLIENT_URL="http://localhost:5173"

# Node environment
NODE_ENV="development"
